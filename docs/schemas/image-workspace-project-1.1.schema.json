{
  "$defs": {
    "GridRecipe": {
      "additionalProperties": false,
      "properties": {
        "columns": {
          "maximum": 8,
          "minimum": 1,
          "title": "Columns",
          "type": "integer"
        },
        "gap_px": {
          "maximum": 1000,
          "minimum": 0,
          "title": "Gap Px",
          "type": "integer"
        }
      },
      "required": [
        "columns",
        "gap_px"
      ],
      "title": "GridRecipe",
      "type": "object"
    },
    "ProjectSource": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "pattern": "^s[0-7]$",
          "title": "Key",
          "type": "string"
        },
        "member": {
          "pattern": "^sources/[0-7]\\.bin$",
          "title": "Member",
          "type": "string"
        },
        "original_name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Original Name",
          "type": "string"
        },
        "bytes": {
          "exclusiveMinimum": 0,
          "maximum": 1073741824,
          "title": "Bytes",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "recorded_metadata": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recorded Metadata"
        }
      },
      "required": [
        "key",
        "member",
        "original_name",
        "bytes",
        "sha256"
      ],
      "title": "ProjectSource",
      "type": "object"
    },
    "WorkspaceNativeMeasurement": {
      "additionalProperties": false,
      "properties": {
        "settings": {
          "additionalProperties": true,
          "title": "Settings",
          "type": "object"
        },
        "roi": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Roi"
        },
        "redirect_source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Redirect Source"
        },
        "redirect_plane": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "integer"
              },
              "propertyNames": {
                "enum": [
                  "C",
                  "Z",
                  "T"
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Redirect Plane"
        }
      },
      "required": [
        "settings"
      ],
      "title": "WorkspaceNativeMeasurement",
      "type": "object"
    },
    "WorkspaceSelection": {
      "additionalProperties": false,
      "properties": {
        "indices": {
          "additionalProperties": {
            "type": "integer"
          },
          "propertyNames": {
            "enum": [
              "C",
              "Z",
              "T"
            ]
          },
          "title": "Indices",
          "type": "object"
        },
        "roi": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Roi"
        },
        "extra_measurements": {
          "items": {
            "enum": [
              "std_dev",
              "median",
              "mode",
              "integrated_density"
            ],
            "type": "string"
          },
          "maxItems": 4,
          "title": "Extra Measurements",
          "type": "array"
        }
      },
      "title": "WorkspaceSelection",
      "type": "object"
    },
    "WorkspaceSourceState": {
      "additionalProperties": false,
      "properties": {
        "collection": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Collection"
        },
        "selection": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkspaceSelection"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "native_measurement": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkspaceNativeMeasurement"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "WorkspaceSourceState",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "sources": {
      "items": {
        "$ref": "#/$defs/ProjectSource"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Sources",
      "type": "array"
    },
    "schema_version": {
      "enum": [
        "1.0",
        "1.1"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "kind": {
      "pattern": "^image_workspace$",
      "title": "Kind",
      "type": "string"
    },
    "source_states": {
      "additionalProperties": {
        "$ref": "#/$defs/WorkspaceSourceState"
      },
      "title": "Source States",
      "type": "object"
    },
    "active_source_key": {
      "anyOf": [
        {
          "pattern": "^s[0-7]$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Active Source Key"
    },
    "selected_source_keys": {
      "items": {
        "type": "string"
      },
      "maxItems": 8,
      "title": "Selected Source Keys",
      "type": "array"
    },
    "grid": {
      "$ref": "#/$defs/GridRecipe"
    }
  },
  "required": [
    "sources",
    "schema_version",
    "kind"
  ],
  "title": "ImageWorkspaceProject",
  "type": "object"
}
